# PostgreSQL local (driver psycopg v3, instalado por psycopg[binary] no requirements.txt).
# No pgAdmin, use role triton, senha triton_dev, banco triton e porta 5432,
# ou altere a URL para corresponder ao usuario, senha, host, porta e banco da sua instalacao.
DATABASE_URL=postgresql+psycopg://triton:triton_dev@localhost:5432/triton
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
APP_ENV=development
ALERT_STALE_AFTER_HOURS=48
# Keep empty until exact INMET CSV columns and units have been checked in an official archive.
INMET_CSV_SCHEMA_JSON=
INMET_TIMEOUT_SECONDS=20
INMET_CACHE_TTL_SECONDS=3600
INMET_MAX_ARCHIVE_BYTES=536870912
INMET_MAX_UNCOMPRESSED_BYTES=4294967296
MEDIA_STORAGE_DIRECTORY=private_uploads
RULER_IMAGE_MAX_BYTES=10485760
RULER_IMAGE_MAX_PIXELS=20000000
# Local scanned-PDF OCR only; requires Tesseract and Poppler (pdftoppm).
OCR_ENABLED=false
OCR_TESSERACT_COMMAND=tesseract
OCR_PDF_RENDERER_COMMAND=pdftoppm
OCR_LANGUAGES=por+eng
OCR_TIMEOUT_SECONDS=30
